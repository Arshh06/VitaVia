# VitaVia Configuration

# Optional: Google Gemini API key for clinical decision support.
# If left blank, the application will automatically use built-in heuristic clinical triage fallback.
GEMINI_API_KEY=

# Optional: Google Maps Platform API key for live Routes API traffic queries.
# If left blank, the application will automatically use built-in simulated traffic-aware routing fallback.
GOOGLE_MAPS_API_KEY=

# Backend Host & Port Configuration
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
BACKEND_URL=http://127.0.0.1:8000
